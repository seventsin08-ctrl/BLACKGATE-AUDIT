# Copy values into Netlify > Site configuration > Environment variables (scope: Functions).
# NEVER commit real values. Mark all of these as "secret".
APP_SECRET=            # random 32+ char string; encrypts 2FA secrets
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=   # temporary Superadmin password; must be changed at first login
# ADMIN_RECOVERY_RESET=   # optional: set to any NEW value to reset the Superadmin (see docs/OPERATIONS.md)
